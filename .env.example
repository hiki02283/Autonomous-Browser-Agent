# LLM API Keys (Provide at least one, or use Local AI / Custom endpoint)
GOOGLE_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Local AI (Ollama / LM Studio)
LOCAL_AI_BASE_URL=http://localhost:11434/v1
LOCAL_AI_MODEL=llama3.2

# Custom OpenAI-Compatible Endpoints (OpenRouter, DeepSeek, Groq, Together, etc.)
CUSTOM_OPENAI_BASE_URL=
CUSTOM_OPENAI_MODEL=
CUSTOM_OPENAI_API_KEY=

# LLM Selection
# Providers: google (default), openai, anthropic, local, custom
DEFAULT_LLM_PROVIDER=google
# Recommended Models: gemini-3.5-flash, gpt-4o-mini, claude-3-5-sonnet-latest
DEFAULT_LLM_MODEL=gemini-3.5-flash

# Browser Configuration
# Options: auto (detects installed Brave -> Chrome -> Edge -> Chromium), brave, chrome, edge, chromium
BROWSER_TYPE=auto

# Optional: Exact path to browser binary (leave empty to auto-detect)
# e.g.: C:\Program Files\BraveSoftware\Brave-Browser\Application\brave.exe
BROWSER_EXECUTABLE_PATH=

# Execution Mode: false = headed/visible (recommended for human-in-the-loop), true = headless
BROWSER_HEADLESS=false

# Window Dimensions
WINDOW_WIDTH=1280
WINDOW_HEIGHT=900

# Optional CDP URL to attach to an already running browser instance (e.g. http://localhost:9222)
CDP_URL=
